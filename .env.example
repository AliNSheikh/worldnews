# AI editorial generation
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Public production origin, e.g. https://news.example.com
APP_URL="https://YOUR_DOMAIN.example"

# Persistent database (Supabase Postgres via server-side REST)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Vercel Cron authentication. Generate a long random secret.
CRON_SECRET="YOUR_LONG_RANDOM_CRON_SECRET"

# Server-side newsroom authentication. Never expose these with a VITE_ prefix.
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="YOUR_LONG_RANDOM_SESSION_SIGNING_SECRET"
