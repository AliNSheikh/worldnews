# AI editorial generation
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Public production origin, e.g. https://news.example.com
APP_URL="https://YOUR_DOMAIN.example"

# Turso / libSQL (primary persistent database)
# Find these in the Turso dashboard for your database.
TURSO_DATABASE_URL="libsql://YOUR_DATABASE-YOUR_ORG.turso.io"
TURSO_AUTH_TOKEN="YOUR_TURSO_DATABASE_AUTH_TOKEN"

# Vercel Cron authentication. Generate a long random secret.
CRON_SECRET="YOUR_LONG_RANDOM_CRON_SECRET"

# Server-side newsroom authentication. Never expose these with a VITE_ prefix.
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="YOUR_LONG_RANDOM_SESSION_SIGNING_SECRET"

# Google Search Console URL-prefix HTML-tag verification token.
# Paste only the content value, not the entire <meta> tag.
# The control panel also stores a runtime value; this environment value ensures
# the verification tag is present in the initial HTML response.
GOOGLE_SITE_VERIFICATION="YOUR_GOOGLE_SITE_VERIFICATION_TOKEN"

# Optional: legacy Appwrite credentials used only by
# npm run turso:migrate:appwrite if the old project is temporarily reachable.
APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID=""
APPWRITE_API_KEY=""
APPWRITE_DATABASE_ID="worldnews"
APPWRITE_ARTICLES_TABLE_ID="newsroom_articles"
APPWRITE_CATEGORIES_TABLE_ID="newsroom_categories"
APPWRITE_SOURCES_TABLE_ID="newsroom_sources"
APPWRITE_COMMENTS_TABLE_ID="newsroom_comments"
APPWRITE_LOGS_TABLE_ID="newsroom_logs"
APPWRITE_SETTINGS_TABLE_ID="newsroom_settings"
